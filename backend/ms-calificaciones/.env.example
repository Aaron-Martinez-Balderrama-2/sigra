# Copiar a .env. Configuración local con compose.dev.yml.
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27018/sigra_calificaciones?replicaSet=rs0&directConnection=true
MONGO_DB=sigra_calificaciones
KEYCLOAK_ISSUER=http://localhost:8180/realms/sigra-calificaciones-dev
KEYCLOAK_AUDIENCE=sigra-calificaciones
CORS_ORIGINS=http://localhost:4200,http://localhost:5173
GRAPHQL_INTROSPECTION=true

# Clientes reales del equipo: contratos REST de ms-asistencia y ms-riesgo.
MS_ASISTENCIA_URL=http://localhost:8081
MS_RIESGO_URL=http://localhost:8001
ASISTENCIA_CONTRATO_CONFIRMADO=true
ASISTENCIA_CREAR_MARCA_PATH=/api/v1/asistencia/marcas
ASISTENCIA_CONSULTAR_MARCA_PATH=/api/v1/asistencia/marcas/{operationId}
ASISTENCIA_COMPENSAR_MARCA_PATH=/api/v1/asistencia/marcas/{id}/compensar
ASISTENCIA_RESUMEN_PATH=/api/v1/asistencia/resumen?estudianteId={estudianteId}&cursoId={cursoId}
RIESGO_ALERTAS_PATH=/api/v1/riesgo/alertas?estudianteId={estudianteId}&cursoId={cursoId}

# Agente opcional: proveedor real compatible con chat/completions y tool calling.
LLM_CHAT_URL=
LLM_MODEL=
LLM_API_KEY=

# Solo desarrollo: usuarios del realm importado; reemplazar por sub reales al integrar.
DEMO_DOCENTE_SUB=11111111-1111-4111-8111-111111111111
DEMO_PADRE_SUB=22222222-2222-4222-8222-222222222222
DEMO_DIRECTOR_SUB=33333333-3333-4333-8333-333333333333
