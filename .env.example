# =============================================================================
# SIGRA - Variables de Entorno de Infraestructura (Grupo 10)
# Copie este archivo como .env para personalizar sus credenciales locales.
# =============================================================================

# PostgreSQL (ms-asistencia - Spring Boot)
POSTGRES_DB=sigra_asistencia
POSTGRES_USER=sigra
POSTGRES_PASSWORD=sigra_dev
POSTGRES_PORT=5432

# MongoDB (ms-calificaciones - NestJS)
MONGO_DB=sigra_calificaciones
MONGO_USER=sigra
MONGO_PASSWORD=sigra_dev
MONGO_PORT=27017

# DynamoDB Local (ms-riesgo - Laravel)
DYNAMODB_PORT=8000

# Keycloak (SSO OIDC)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8080

# n8n (Automatización de flujos)
N8N_PORT=5678
TZ=America/La_Paz
GENERIC_TIMEZONE=America/La_Paz
